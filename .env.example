# Copy these names into your user environment. Never commit real values.
LONGBRIDGE_APP_KEY=replace_me
LONGBRIDGE_APP_SECRET=replace_me
LONGBRIDGE_ACCESS_TOKEN=replace_me

# Both US (all four sessions) and HK use Longbridge quotes only.
# Mainland endpoint is preferred; the international endpoint is a fallback.
# Optional explicit overrides:
# LONGBRIDGE_HTTP_URL=https://openapi.longbridge.cn
# LONGBRIDGE_QUOTE_WS_URL=wss://openapi-quote.longbridge.cn
